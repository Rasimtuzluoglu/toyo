# PostgreSQL 16 Alpine, Go tabanlı gosu yerine C tabanlı su-exec kullanır.
# Amaç: gosu içindeki eski Go stdlib CVE'lerini kaldırmak.
#
# Not: Resmi postgres imajındaki gosu binary'si silinse bile temel katman SBOM'unda
# görünmeye devam ediyordu. Bu nedenle dosya sistemi, gosu silinmiş haliyle
# temiz bir scratch katmanına kopyalanır.
FROM postgres:18-alpine@sha256:0115267ab5a509022df9319c77be365cef335adb71556c75f60f5360ee247e71 AS source

RUN apk upgrade --no-cache \
    && apk add --no-cache su-exec \
    && rm -f /usr/local/bin/gosu /usr/local/bin/su-exec \
    && ln -s /sbin/su-exec /usr/local/bin/gosu \
    && ln -s /sbin/su-exec /usr/local/bin/su-exec

FROM scratch

COPY --from=source / /

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=en_US.utf8 \
    PG_MAJOR=16 \
    PGDATA=/var/lib/postgresql/data

STOPSIGNAL SIGINT
EXPOSE 5432
VOLUME /var/lib/postgresql/data
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]
