# ServisDefteri - ortam degiskenleri ornegi
# Bu dosyayi .env olarak kopyalayin ve degerleri mutlaka degistirin.
# .env dosyasi Git'e eklenmemelidir.

POSTGRES_DB=servisdefteri
POSTGRES_USER=servisdefteri
# En az 16 karakter, tahmin edilmesi zor bir parola kullanin.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Docker'da disari acilan uygulama portu (host uzerinde 8080 doluysa 18080 kullanilir)
APP_PORT=18080
# Yalnizca bu bilgisayardan erisim icin 127.0.0.1; tablet/telefon icin 0.0.0.0 birakin.
APP_BIND_ADDRESS=0.0.0.0

# Oturum suresi (varsayilan 2 saat)
SESSION_TIMEOUT=2h

# Uygulama ilk acilista kullanici yoksa bu bilgilerle PATRON olusturur.
# Bos birakilirsa /setup ekranindan ilk isletme sahibi olusturulur.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Isletme Sahibi

# Yedekleme
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 0 2 * * *
