# ServisDefteri - ortam degiskenleri ornegi
# Bu dosyayi .env olarak kopyalayin ve degerleri mutlaka degistirin.
# .env dosyasi Git'e eklenmemelidir.

POSTGRES_DB=servisdefteri
POSTGRES_USER=servisdefteri
# En az 16 karakter, tahmin edilmesi zor bir parola kullanin.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Docker'da disari acilan uygulama portu (host uzerinde 8080 doluysa 18080 kullanilir)
APP_PORT=18080
# Varsayilan yalnizca bu bilgisayar. Uygulamayi yerel aga acmayin.
APP_BIND_ADDRESS=127.0.0.1

# Ilk kurulum /setup ekrani icin tek kullanimlik token. Bos birakilirsa token istenmez.
# Doluysa kurulum yalnizca /setup?token=... adresiyle acilir.
SETUP_TOKEN=

# Otomatik guncelleme varsayilan kapalidir. Acilirsa yalnizca imzali commit'ler uygulanir.
APP_UPDATE_ENABLED=false
UPDATE_REQUIRE_SIGNED=true

# Oturum suresi (varsayilan 2 saat)
SESSION_TIMEOUT=2h
# TLS/reverse proxy arkasinda true yapin; duz HTTP'de false kalmali.
SESSION_COOKIE_SECURE=false
# Dogrudan yerel agda none; guvenilen ters proxy arkasinda framework.
FORWARD_HEADERS_STRATEGY=none

# Uygulama ilk acilista kullanici yoksa bu bilgilerle PATRON olusturur.
# Bos birakilirsa /setup ekranindan ilk isletme sahibi olusturulur.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Isletme Sahibi

# Yedekleme
BACKUP_ENABLED=true
# Container icindeki yol; degistirmeyin.
BACKUP_DIR=/app/backups
# Bilgisayardaki gercek yedek klasoru. Ornek: C:/ToyotaServis-Yedekler
BACKUP_HOST_DIR=./backups
# Ikinci kopya (harici disk/NAS). Bos birakilirsa kopya alinmaz.
BACKUP_COPY_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 0 2 * * *
